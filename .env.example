# ---------- REQUIRED ----------
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=mysql+pymysql://skillswap_user:StrongPassword123@127.0.0.1:3306/skillswap?charset=utf8mb4
FLASK_APP=run.py
FLASK_DEBUG=1

# ---------- VIDEO (Jitsi) ----------
# meet.jit.si is for quick demos only: embedded meetings are limited (~5 min) / need auth.
# For real use: self-host Jitsi or use JaaS (8x8.vc).
JITSI_DOMAIN=meet.jit.si
JITSI_SCRIPT_URL=https://meet.jit.si/external_api.js

# ---------- WALLET ----------
SIGNUP_BONUS_CREDITS=2.0

# ---------- AI (ALL OPTIONAL) ----------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required ONLY if you want users to save their own OpenAI key (BYOK).
AI_ENCRYPTION_KEY=

# Mode C: platform OpenAI (admin-paid). Leave blank to disable.
PLATFORM_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# Mode B: free AI
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Hosted free-tier (any OpenAI-compatible endpoint, e.g. Groq)
HOSTED_FREE_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# Limits
AI_USER_REQUESTS_PER_DAY=30
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=1200
